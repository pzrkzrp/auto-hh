{
  "name": "auto-hh-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Монорепозиторий auto-hh: CLI (packages/cli) + бэкенд NestJS (packages/backend) + фронтенд Angular (packages/frontend)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "npm run -w packages/cli start",
    "apply": "npm run -w packages/cli apply",
    "login": "npm run -w packages/cli login",
    "schedule": "npm run -w packages/cli schedule",
    "resume:list": "npm run -w packages/cli resume:list",
    "resume:show": "npm run -w packages/cli resume:show",
    "resume:register": "npm run -w packages/cli resume:register",
    "build": "npm run -w packages/cli build",
    "watch": "npm run -w packages/cli watch",
    "migrate:up": "npm run -w packages/cli migrate:up",
    "migrate:down": "npm run -w packages/cli migrate:down",
    "migrate:create": "npm run -w packages/cli migrate:create",
    "backend:start": "npm run -w packages/backend start:dev",
    "frontend:start": "npm run -w packages/frontend start",
    "build:backend": "npm run -w packages/backend build",
    "build:frontend": "npm run -w packages/frontend build"
  }
}
