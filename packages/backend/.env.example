# Конфигурация веб-бэкенда (NestJS). Скопируйте в .env: cp .env.example .env

# MongoDB URI. Веб-бэкенд работает с ОТДЕЛЬНОЙ базой web-autohh
# (CLI использует свою — autohh в packages/cli/.env).
MONGODB_URI=mongodb://localhost:27017/web-autohh

# Порт HTTP-сервера
PORT=3001

# Разрешённые CORS-источники через запятую (фронтенд Angular)
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# Секреты JWT. Обязательно смените вне локальной разработки —
# в коде есть dev-fallback, но для продакшена задайте явно.
JWT_SECRET=
JWT_REFRESH_SECRET=

# 32-байтный ключ AES для шифрования токенов hh.ru пользователей.
# В коде есть dev-fallback — смените вне локальной разработки.
ENCRYPTION_KEY=

# Директория с резюме (путь резолвится от корня запуска)
RESUME_DIR=
