{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // npm workspaces хойстит @types/* в корневой node_modules; автоподключение из
    // packages/cli его не находит, поэтому типы node подключаем явно.
    "types": ["node"],
    "declaration": false,
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "app.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "data"]
}